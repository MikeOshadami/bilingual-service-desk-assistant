# Copy to .env and adjust. Docker Compose reads .env automatically.

# Ollama runs natively on your Mac (uses the Apple GPU). The app container reaches it through host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=bge-m3

# true = Keycloak sign-in enforced for staff endpoints (public endpoints stay open)
SECURITY_ENABLED=true

# Local-only demo credentials. Change them if you expose anything beyond localhost.
POSTGRES_PASSWORD=servicedesk
KEYCLOAK_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_PASSWORD=admin
